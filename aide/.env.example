# ─────────────────────────────────────────────────────────────────────────────
# Provider selection
# choose: OPENAI | OPENROUTER | GOOGLE | LOCAL
ACTIVE_PROVIDER=OPENROUTER
ACTIVE_AGENT=ELARA
AGENT_CONFIG=C:\Users\squii\OneDrive\Desktop\icev-CLI_Coder\agent\elara.yaml
MODEL=openrouter/sonoma-sky-alpha

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter
# Get models at https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_OUTPUT=2048
OPENROUTER_SITE=https://openrouter.ai/
OPENROUTER_TITLE=icev-CLI-openrouter

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI
# Get models at https://platform.openai.com/docs/models
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_OUTPUT=2048

# ─────────────────────────────────────────────────────────────────────────────
# Google (Gemini)
# For the GOOGLE provider in src/config.ts we read API_KEY.
API_KEY=<GOOGLE>
# Optional legacy keys some libs still check:
GEMINI_API_KEY=<GEMINI_API_KEY>
GOOGLE_MODEL=<GOOGLE_MODEL>
GEMINI_MODEL=<GEMINI_MODEL>

# ─────────────────────────────────────────────────────────────────────────────
# Coverage thresholds (vitest)
COVERAGE_MIN_LINES=80
COVERAGE_MIN_BRANCHES=70
COVERAGE_MIN_FUNCTIONS=80
COVERAGE_MIN_STATEMENTS=80

# ─────────────────────────────────────────────────────────────────────────────
# Semgrep config
SEMGREP_CONFIG=p/ci
SEMGREP_TIMEOUT=120
SEMGREP_DISABLE_VERSION_CHECK=1

# ─────────────────────────────────────────────────────────────────────────────
# ICEV Settings
ICEV_INCLUDE=src/**/*,app/**/*,lib/**/*,*.md
ICEV_EXCLUDE=node_modules/**,dist/**,build/**,.git/**
ICEV_MAX_CONTEXT_BYTES=700000
# Security hardening
ICEV_SECURITY_STRICT=true
ICEV_ALLOW_CONFIG_API_KEYS=false

# ─────────────────────────────────────────────────────────────────────────────
# UI / Server
PORT=3000
ICEV_GUI_TOKEN=change-me # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also located at the botton of config.ts
ICEV_SYSTEM="You are a sovereign, precision-driven autonomous code editor; each prompt is a direct overwrite—return only the fully revised file: clean, complete, unadorned; no syntax wrappers, no commentary, no ceremony; total overwrite is law, brevity and clarity your doctrine; output code only—everything else is noise."
ICEV_COVERAGE_MIN=0